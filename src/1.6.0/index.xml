<?xml version="1.0" encoding="utf-8"?>
<skin>
  <!--
    ========================================
    티스토리 스킨 메타데이터 파일
    ========================================
    이 파일은 티스토리에 스킨 정보를 알려주는 설정 파일입니다.
    스킨 이름, 버전, 색상 등을 여기서 관리합니다.
  -->

  <information>
    <!-- 스킨 기본 정보 -->
    <name>Code Editor Blog</name>
    <version>1.6.0</version>
    <description>
      <![CDATA[
        Cursor AI 에디터 스타일의 모던한 기술 블로그 스킨입니다.
        다크 테마, 코드 친화적 디자인, SEO 최적화가 특징입니다.
      ]]>
    </description>
    <license>
      <![CDATA[MIT License]]>
    </license>
  </information>

  <!-- 제작자 정보 -->
  <author>
    <name>Merryiscat</name>
    <homepage>https://github.com/merryiscat</homepage>
    <email>minhyuk1463@naver.com</email>
  </author>

  <!-- 기본 설정 -->
  <default>
    <!--
      한 페이지에 보여줄 글 개수
      변경 방법: 티스토리 관리자 > 꾸미기 > 스킨 편집 > 설정
    -->
    <recentEntries>15</recentEntries>
    <recentComments>5</recentComments>
    <recentTrackbacks>5</recentTrackbacks>
    <itemsOnGuestbook>10</itemsOnGuestbook>
    <tagsInCloud>30</tagsInCloud>
    <sortInCloud>1</sortInCloud>
    <expandComment>0</expandComment>
    <expandTrackback>0</expandTrackback>
    <lengthOfRecentNotice>25</lengthOfRecentNotice>
    <lengthOfRecentEntry>27</lengthOfRecentEntry>
    <lengthOfRecentComment>30</lengthOfRecentComment>
    <lengthOfRecentTrackback>30</lengthOfRecentTrackback>
    <lengthOfLink>30</lengthOfLink>
    <showListOnCategory>1</showListOnCategory>
    <showListOnTag>1</showListOnTag>
    <contentWidth>1000</contentWidth>
  </default>

  <!--
    ========================================
    사용자 정의 변수
    ========================================
    티스토리 관리자 페이지에서 쉽게 변경할 수 있는 설정들입니다.
    변경 방법: 관리자 > 꾸미기 > 스킨 편집 > 설정
  -->
  <variables>

    <!-- 외관 설정 -->
    <variablegroup name="외관 설정">

      <!-- 메인 강조 색상 (파란색 기본) -->
      <variable>
        <name>accentColor</name>
        <label><![CDATA[메인 강조 색상]]></label>
        <description><![CDATA[링크, 버튼 등에 사용되는 메인 색상입니다.]]></description>
        <type>COLOR</type>
        <default>#007acc</default>
      </variable>

      <!--
        참고: 1.1.0에서 sidebarBgColor / mainBgColor / textColor 변수를 제거했습니다.
        스킨 전체가 다크 에디터 팔레트로 통일되어 있어 개별 색상 변경 시
        디자인이 깨지기 쉬우므로, 강조 색상(accentColor)만 옵션으로 제공합니다.
      -->

    </variablegroup>

    <!-- 레이아웃 설정 -->
    <variablegroup name="레이아웃 설정">

      <!-- 사이드바 너비 -->
      <variable>
        <name>sidebarWidth</name>
        <label><![CDATA[사이드바 너비]]></label>
        <description><![CDATA[왼쪽 사이드바의 너비를 선택하세요.]]></description>
        <type>SELECT</type>
        <option>
          <name>좁게 (200px)</name>
          <value>200px</value>
        </option>
        <option>
          <name>보통 (250px)</name>
          <value>250px</value>
        </option>
        <option>
          <name>넓게 (300px)</name>
          <value>300px</value>
        </option>
        <default>300px</default>
      </variable>

      <!--
        참고: 1.1.0에서 enableLightMode 변수를 제거했습니다.
        이 스킨은 다크 전용으로 확정되었습니다.
      -->

    </variablegroup>

    <!-- 기능 설정 -->
    <variablegroup name="기능 설정">

      <!-- 검색 기능 -->
      <variable>
        <name>enableSearch</name>
        <label><![CDATA[검색 기능 표시]]></label>
        <description><![CDATA[상단에 검색 입력창을 표시할지 선택하세요.]]></description>
        <type>BOOL</type>
        <default>true</default>
      </variable>

      <!--
        참고: 1.1.0에서 enableTOC / enableLazyLoad 변수를 제거했습니다.
        해당 기능이 실제로 구현되어 있지 않아, 켜도 동작하지 않는
        "거짓 옵션"이었기 때문입니다. 기능 구현 시 다시 추가 예정.
      -->

    </variablegroup>

    <!-- 폰트 설정 -->
    <variablegroup name="폰트 설정">

      <!-- 코드 폰트 -->
      <variable>
        <name>codeFont</name>
        <label><![CDATA[코드 폰트]]></label>
        <description><![CDATA[코드 블록에 사용할 모노스페이스 폰트를 선택하세요.]]></description>
        <type>SELECT</type>
        <option>
          <name>JetBrains Mono</name>
          <value>'JetBrains Mono', monospace</value>
        </option>
        <option>
          <name>Fira Code</name>
          <value>'Fira Code', monospace</value>
        </option>
        <option>
          <name>Consolas</name>
          <value>Consolas, monospace</value>
        </option>
        <option>
          <name>Monaco</name>
          <value>Monaco, monospace</value>
        </option>
        <default>'JetBrains Mono', monospace</default>
      </variable>

    </variablegroup>

  </variables>

</skin>
